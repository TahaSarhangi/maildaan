# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build artifacts
build/
dist/
*.spec.bak

# User data — NEVER commit (stored in %LOCALAPPDATA%\MailDaan)
*.db
*.db-wal
*.db-shm
*.sqlite
*.eml
exports/
attachments/
eml/
data/

# Logs and temp
*.log
tmp/
temp/

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Offline installer build inputs (auto-downloaded by build-installer.ps1)
# The Microsoft offline runtime redistributables are large and must never be
# committed; the build verifies their signature and embeds them into
# dist\MailDaan-Setup-<version>.exe.
tools/*
!tools/make_icon.py
installer/prerequisites/*.exe
installer/prerequisites/*.cab
installer/prerequisites/manifest.json
# Extracted WebView2 Fixed Version Runtime (from the .cab above)
webview2_runtime/

# Windows Sandbox test artifacts (sandbox-test.wsb and input\test.ps1 are kept;
# the copied installer and all test outputs are transient)
sandbox-share/input/MailDaan-Setup-*.exe
sandbox-share/output/
