<Configuration>
  <Networking>Disable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Projects\MailDaan\sandbox-share\input</HostFolder>
      <SandboxFolder>C:\sb-input</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Projects\MailDaan\sandbox-share\output</HostFolder>
      <SandboxFolder>C:\sb-output</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -File C:\sb-input\test.ps1</Command>
  </LogonCommand>
</Configuration>
